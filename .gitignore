# ignore configuration files
**/.vscode
**/.venv
**/.idea

# ignore macOS Finder configuration storage files
**/.DS_Store

.claude/
.env

# --- Rust firmware workspace (docs/rust-migration 05 §2) ---
# Build output of the root Cargo workspace and of the ESP-IDF build that
# esp-idf-sys drives (.embuild/ holds the ESP-IDF clone + its toolchain, ~4 GB).
target/
.embuild/
# Generated by `just env-file`; sources the Xtensa GCC onto PATH.
.rust-esp-env.sh

# Python bytecode. `crates/cc-display/tools/extract_fonts.py` was run in place
# and its __pycache__ was committed (Python 3.14 specific, arch specific).
__pycache__/
*.pyc

# Generated by espup / hand-written export shims. `just env-file` owns
# `.rust-esp-env.sh` above; this is the older sibling nothing reads.
.espup-env.sh

# Stray terminal and capture logs. `tmux-client-715894.log` was a 22 KB tmux
# log that got committed with the C++ removal and sat at the repository root
# for the whole restructure; nobody noticed, which is what an untracked-looking
# file at the root does.
*.log
