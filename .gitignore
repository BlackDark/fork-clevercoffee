# ignore data directory
data/*

# ignore PlatformIO build directory
.pio

# Rust build output
/target/
/firmware/target/
/firmware/.embuild/

# Unscrubbed config export / device seed at the repo root. A real export contains
# the machine's Wi-Fi password in plaintext. The scrubbed fixture lives at
# tests/fixtures/config-export-cpp.json.
/config.json

# Python tooling venv created by `just setup` (platformio + nvs partition gen)
.venv/

# Downloaded upstream docs/sources for migration research (not part of the build)
research/*

# ignore configuration files
**/.vscode
**/.venv
**/.idea

# ignore macOS Finder configuration storage files
**/.DS_Store

platformio_extra.ini

# ignore flash package
CleverCoffee_Flash_Package

.claude/
.env
