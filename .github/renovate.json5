// From BlackDark/agent-presets templates/renovate.template.json5 (Go rules removed, esp-rs rules added).
// Repo settings: enable "Allow auto-merge" and require the CI status checks on main,
// otherwise platform automerge lands PRs before CI ran.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices", // recommended + digest pins for Docker images and GitHub Actions
    "security:minimumReleaseAgeNpm", // npm releases wait 3 days (unpublish window, hijacked releases)
    "customManagers:githubActionsVersions", // `# renovate: datasource=… depName=…` comments in workflows
    ":pinVersions", // exact versions in package.json; libraries: remove, ranges belong there
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
  ],
  labels: ["dependencies"],
  semanticCommits: "enabled",
  timezone: "Europe/Berlin",

  // --- Schedule: pick one ---
  // Weekly: branches are created/updated Monday early morning only.
  schedule: ["before 4am on monday"],
  // Always: delete `schedule` above (or use ["at any time"]).
  // Monthly: extends "schedule:monthly".

  // With a schedule, Renovate's own automerge only runs inside the window too, so a PR that turns
  // green later would wait a week. Platform automerge (GitHub native) merges it as soon as CI passes.
  updateNotScheduled: false,
  platformAutomerge: true,

  separateMajorMinor: true,
  separateMultipleMajor: true,

  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },

  // Later rules override earlier ones: general first, specific after.
  packageRules: [
    {
      description: "Group and automerge patch, pin and digest updates",
      matchUpdateTypes: ["patch", "pin", "pinDigest", "digest"],
      groupName: "all patch/pin/digest updates",
      groupSlug: "all-patch-pin-digest",
      automerge: true,
    },
    {
      description: "Group and automerge minor updates",
      matchUpdateTypes: ["minor"],
      groupName: "all minor updates",
      groupSlug: "all-minor",
      automerge: true,
    },
    {
      description: "0.x: minor may break, review by hand",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      groupName: null,
      automerge: false,
    },
    {
      description: "Node runtime (mise + node images) in one PR",
      matchManagers: ["mise", "dockerfile", "docker-compose", "nodenv", "nvm"],
      matchPackageNames: ["node", "docker.io/library/node"],
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      groupName: "node runtime",
      groupSlug: "node-runtime",
      automerge: true,
    },
    {
      // Renovate flags packages without a release for a year (abandonments:recommended).
      // Finished micro-libs are not abandoned; list them with the reason, and add the repo's own.
      description: "Finished, dependency-free packages: no abandonment warning",
      matchPackageNames: [
        "clsx", // ~200 B className join, nothing left to add
        "class-variance-authority", // 0.7 stable, generated by shadcn/ui
        "embedded-hal", // 1.0 is the stable trait crate
        "embedded-io-async",
        "embassy-futures",
        "postcard",
        "static_cell",
        "uplot", // small, complete chart library
      ],
      abandonmentThreshold: null,
    },
    {
      description: "TypeScript 6: svelte-check needs TS 6 installed next to TS 7 (@typescript/native, --tsgo)",
      matchManagers: ["npm"],
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      // 0.8 renames the scanner API and HostResources generics (firmware/src/ble_scale.rs) and
      // pulls bt-hci 0.10 while esp-radio still uses 0.9. Port the code, then drop both rules.
      description: "Hold trouble-host below 0.8 and bt-hci below 0.10 until the BLE scale code is ported",
      matchManagers: ["cargo"],
      matchPackageNames: ["trouble-host"],
      allowedVersions: "<0.8.0",
    },
    {
      description: "Hold bt-hci below 0.10 (see trouble-host)",
      matchManagers: ["cargo"],
      matchPackageNames: ["bt-hci"],
      allowedVersions: "<0.10.0",
    },
    {
      // esp-hal, esp-rtos, esp-radio, esp-bootloader-esp-idf, esp-storage, ... are released
      // together and pinned exactly (`=x.y.z`); mixed versions do not link.
      description: "esp-rs stack moves together, reviewed by hand",
      matchManagers: ["cargo"],
      matchPackageNames: ["/^esp-/", "/^embassy-/", "trouble-host", "bt-hci", "/^edge-/", "picoserve", "rust-mqtt"],
      groupName: "esp-rs stack",
      groupSlug: "esp-rs",
      automerge: false,
    },
    {
      description: "Majors: one PR each, merged by hand",
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
      automerge: false,
    },
    // Examples, copy and fill in when needed. Always say why and when to drop the rule.
    // {
    //   description: "Hold <pkg> below <x.y> until <upstream issue> is fixed",
    //   matchPackageNames: ["<pkg>"],
    //   allowedVersions: "<x.y.0",
    // },
    // {
    //   description: "Frozen on purpose: <reason>",
    //   matchPackageNames: ["<pkg>"],
    //   enabled: false,
    // },
  ],

  customManagers: [
    {
      customType: "regex",
      description: "Rust toolchain channel in rust-toolchain.toml",
      managerFilePatterns: ["/(^|/)rust-toolchain\\.toml$/"],
      matchStrings: ["channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "rust",
      packageNameTemplate: "rust-lang/rust",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Versions pinned under a `# renovate: datasource=… depName=…` comment (justfile)",
      managerFilePatterns: ["/(^|/)justfile$/"],
      // Comment line, then `name := "version"`. Optional: versioning=…, extractVersion=….
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\S+\\s*:=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
}
