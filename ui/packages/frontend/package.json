{
  "name": "@clevercoffee/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock --host 0.0.0.0",
    "build": "pnpm check:types && vite --mode production build",
    "postbuild": "rimraf -g \"dist/**/*.html\" \"dist/**/*.js\" \"dist/**/*.css\"",
    "lint": "pnpm -w lint",
    "check:types": "rimraf .svelte-check && svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --tsgo",
    "tsc": "pnpm check:types",
    "check": "pnpm lint && pnpm check:types && pnpm test:run",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "format": "pnpm -w format",
    "check:types:ts6": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings"
  },
  "dependencies": {
    "@lucide/svelte": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/svelte-query": "6.3.6",
    "bits-ui": "2.20.2",
    "cn": "0.5.1",
    "svelte": "5.57.3",
    "svelte-sonner": "1.2.2",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uplot": "1.6.32",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "rollup-plugin-gzip": "4.2.0",
    "shadcn-svelte": "1.7.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
