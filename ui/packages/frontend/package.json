{
  "name": "@clevercoffee/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock --host 0.0.0.0",
    "prebuild": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "build": "pnpm check:types && vite --mode production build",
    "postbuild": "rimraf -g \"dist/**/*.html\" \"dist/**/*.js\" \"dist/**/*.css\"",
    "lint": "pnpm -w lint",
    "precheck:types": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "check:types": "rimraf .svelte-check && svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --tsgo",
    "tsc": "pnpm check:types",
    "check": "pnpm lint && pnpm check:types && pnpm test:run",
    "test": "vitest",
    "pretest:run": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "format": "pnpm -w format",
    "precheck:types:ts6": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "check:types:ts6": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings",
    "lint:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "1.69.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/svelte-query": "6.3.11",
    "bits-ui": "2.20.6",
    "cn": "0.5.2",
    "svelte": "5.57.3",
    "svelte-sonner": "1.2.3",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "uplot": "1.6.32",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-m-function-matcher": "2.3.0",
    "@inlang/plugin-message-format": "4.5.0",
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "rollup-plugin-gzip": "4.2.1",
    "shadcn-svelte": "1.8.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
