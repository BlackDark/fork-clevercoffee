{
  "author": "BlackDark <eduard-marbach.de>",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently 'pnpm run dev:ui' 'pnpm run dev:api'",
    "dev:ui": "pnpm --filter @clevercoffee/frontend dev",
    "dev:api": "pnpm --filter @clevercoffee/mock-server dev",
    "lint": "biome check . && pnpm --filter @clevercoffee/frontend exec prettier --check \"src/**/*.svelte\"",
    "format": "biome check --write . && pnpm --filter @clevercoffee/frontend exec prettier --write \"src/**/*.svelte\"",
    "check": "pnpm lint && pnpm --filter @clevercoffee/frontend check:types && pnpm --filter @clevercoffee/frontend test:run"
  },
  "packageManager": "pnpm@11.28.6",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "concurrently": "10.0.6",
    "rimraf": "6.1.3"
  }
}
